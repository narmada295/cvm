// Operator precedence, grouping, unary minus, modulo, and comparisons.
print 2 + 3 * 4;        // 14  (precedence)
print (2 + 3) * 4;      // 20  (grouping)
print 10 / 4;           // 2.5 (numbers are doubles)
print 17 % 5;           // 2   (modulo)
print -8 + 3;           // -5  (unary minus)

print 3 < 5;            // true
print 10 <= 9;          // false
print 2 + 2 == 4;       // true
print "a" == "a";       // true

// Logical operators short-circuit.
print true and false;   // false
print false or true;    // true
print !false;           // true
